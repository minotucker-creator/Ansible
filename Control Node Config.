#Install Ansible package in Azure SSH CLI
  python3 -m pip install --user ansible

#Verify installion
  ansible --version

#Install tool package
  python3 -m pip install --user ansible-lint

#Azure specific SDK (Software Development Kit)
  python3 -m pip install --user azure-cli azure-mgmt-compute azure-mgmt-resource

#Azure specific Ansible Galaxy Collections
  ansible-galaxy collection install azure.azcollection

#SSH Key Pair on the control node to enable passwordless authentication to managed hosts
  ssh-keygen -t ed25519 -C "ansible-control-node"
  File in which to save key pair: /root/.ssh/ansible_ed25519

#Directory structure for workspace
  mkdir -p ~/ansible/{inventories,roles,playbooks}

#Local configuration file in project directory
touch ~/ansible/ansible.cfg

#Display public key to copy from control node
cat ~/.ssh/id_ed111111.pub

#Prepare SSH directory on managed node
mkdir -p ~/.ssh

#Add control node public key to managed node authorized keys
nano ~/.ssh/authorized_keys

#Apply strict POSIX security permissions on managed node
chmod 700 ~/.ssh
chmod 600 ~/.ssh/authorized_keys

#Verify passwordless SSH connection from control node
ssh username@managed-node-IP-Address

#Remove inventory directory if created as folder by mistake
rm -rf inventory.ini

#Create inventory text file on control node
nano inventory.ini

#Add host definitions and user variables to inventory.ini
[servers]
Managed nodeIP ansible_user=username

#Test Ansible connectivity using the ping module
ansible servers -i inventory.ini -m ping

#Run first ad-hoc system command across host group
ansible servers -i inventory.ini -a "uptime"

#Create initial YAML automation playbook
nano first_playbook.yml
